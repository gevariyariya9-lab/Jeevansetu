
@model JeevanSetu.Models.Hospital

@{
    ViewData["Title"] = "Create Hospital Staff Account";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="mb-3">Create Hospital Staff Account</h2>

                    <p class="text-muted">
                        Hospital: <strong>@Model.Name</strong>
                    </p>

                    <form asp-controller="Hospitals"
                          asp-action="CreateAccount"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="username" class="form-label">
                                Staff Username
                            </label>
                            <input type="text"
                                   id="username"
                                   name="username"
                                   class="form-control"
                                   maxlength="100"
                                   autocomplete="username"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                Staff Password
                            </label>
                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="form-control"
                                   minlength="8"
                                   maxlength="128"
                                   autocomplete="new-password"
                                   required />
                            <small class="text-muted">
                                Use at least 8 characters.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-danger">
                            Save Hospital Account
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
