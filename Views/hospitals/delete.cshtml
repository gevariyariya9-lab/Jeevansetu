
@model JeevanSetu.Models.Hospital

@{
    ViewData["Title"] = "Delete Hospital";
}

<div class="container mt-4">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h4>Delete Hospital</h4>
        </div>

        <div class="card-body">
            <h5>Are you sure you want to delete this hospital?</h5>

            <p><strong>Name:</strong> @Model.Name</p>
            <p><strong>Location:</strong> @(Model.Location ?? "Not provided")</p>
            <p>
                <strong>Critical Status:</strong>
                @(Model.CriticalStatus ? "Critical" : "Normal")
            </p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
